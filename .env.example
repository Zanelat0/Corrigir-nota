# npm run dev / npm start forçam loopback 127.0.0.1 e TRUST_PROXY=false.
# Sem login, banco ou exposição LAN. HTTP permitido somente no modo local explícito.
CORRIGIR_NOTA_LOCAL_ONLY=true
# Opt-in somente para npm run dev em loopback. Build/start nunca habilitam demo.
ENABLE_LOCAL_DEMO=false
TRUST_PROXY=false
# Em NODE_ENV=production a verificação de âncora é obrigatória por padrão.
# Desabilitar apenas em desenvolvimento sintético isolado; nunca para contornar certificado real inválido.
REQUIRE_TRUSTED_CLIENT_CERTIFICATE=true
# Arquivo público de raízes ICP-Brasil obtidas e verificadas pelo operador (não é o certificado A1).
# ICP_BRASIL_TRUST_ROOTS_FILE=C:/config/raizes-icp-brasil-verificadas.pem
# Não há CRL/OCSP implementado. Se sua política exigir, true bloqueia em vez de ignorar.
REQUIRE_CERTIFICATE_REVOCATION=false
# Política pública de schemas, sem dados fiscais/segredos. Vazio bloqueia download final.
# Exemplo SOMENTE SINTÉTICO (NÃO usar como calendário de vigência real):
# NFE_SCHEMA_POLICY_JSON='[{"profile":"NFe-4.00-PL010c-NT2022.002-v1.30+proc009n","model":"65","cUF":"42","tpAmb":"2","from":"2026-09-01","through":"2026-09-01","reference":"TESTE SINTETICO, SEM QUALIFICACAO FISCAL"}]'
# Preencher após verificar NT/vigência por modelo/UF/ambiente/data; veja README.md.
NFE_SCHEMA_POLICY_JSON=
